# Copy to .env.local and fill in. Every value is optional; the defaults are noted.

# ── Site ────────────────────────────────────────────────────────────────
# The real domain. Used for canonical URLs, the sitemap, Open Graph and email links.
NEXT_PUBLIC_SITE_URL=
# "true" at launch to let search engines index the site (until then: noindex + robots disallow).
NEXT_PUBLIC_SITE_INDEXABLE=

# ── Orders ──────────────────────────────────────────────────────────────
# "false" closes ordering (the checkout says so; bags are kept). Default: open.
CHECKOUT_ENABLED=
# Flat shipping fee in PKR added to every order. Empty = shipping "to be confirmed",
# set per order from /admin when you confirm it.
SHIPPING_FLAT_FEE_PKR=

# ── Storage ─────────────────────────────────────────────────────────────
# SQLite file (Node 22.13+ built-in). Needs a persistent disk. Default: data/store.db
DATABASE_PATH=

# ── Admin (/admin) ──────────────────────────────────────────────────────
# Long random password. Empty = admin switched off. Changing it signs everyone out.
ADMIN_PASSWORD=

# ── Email (optional) ────────────────────────────────────────────────────
# Without these, emails are written to the server log instead of being sent.
RESEND_API_KEY=
# A sender on a domain verified with Resend, e.g. "Jaun Elia <orders@example.com>"
MAIL_FROM=
# Where new-order and contact-form notifications go.
TEAM_INBOX_EMAIL=

# ── Hosting ─────────────────────────────────────────────────────────────
# "true" only behind a proxy/CDN you control, so rate limits see the visitor's real IP.
TRUST_PROXY=
